# Discord
DISCORD_BOT_TOKEN=
# Guild (server) ID the bot is scoped to. Right-click your server icon in Discord
# (with Developer Mode on) -> Copy Server ID.
DISCORD_GUILD_ID=

# Generation — an OpenAI-compatible chat completions endpoint. Defaults to
# opencode.ai's free "zen" gateway (deepseek-v4-flash-free, no key needed) —
# see README for why this deviates from the design doc's original Claude
# choice, and the strict-grounding tradeoff that implies.
GENERATION_API_BASE_URL=https://opencode.ai/zen/v1
GENERATION_API_KEY=
GENERATION_MODEL=deepseek-v4-flash-free

# Embeddings — a self-hosted, OpenAI-compatible endpoint (your own
# infrastructure, not a commercial provider). Must serve /v1/embeddings.
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embedding

# RAG tuning
# Rules and cards are retrieved as separate pools (RETRIEVAL_POOL_PER_TYPE
# candidates each, source_type-filtered) then merged by score down to
# RETRIEVAL_K for the LLM's context — see the docstring on RiftboundRagChain
# in rag/chain.py for why a single blended search doesn't work here (the
# ~25x larger card corpus drowns out genuinely more relevant rule content).
#
# RETRIEVAL_SCORE_THRESHOLD was calibrated against Chroma's raw cosine
# similarity. TurboVec's relevance score is (raw_cosine + 1) / 2 — a
# different scale — so this MUST be recalibrated after migrating: retrieve a
# known-relevant query and a clearly off-topic one and confirm a real score
# gap through the actual vectorstore.py/chain.py code path (same procedure
# as before, just re-run against the new store) before trusting the default
# below in production.
RETRIEVAL_POOL_PER_TYPE=10
RETRIEVAL_K=6
RETRIEVAL_SCORE_THRESHOLD=0.45

# Paths (defaults are fine for local dev)
VECTOR_STORE_DIR=data/turbovec
RULES_DIR=data/rules

# Postgres — source of truth for card/rule data (see ingest/db.py,
# ingest/rules_sync.py, ingest/cards_scrape.py). Ingest-time only; the live
# bot never connects to this, only build_index.py's already-built vector
# store. POSTGRES_USER/PASSWORD/DB configure docker-compose's `postgres`
# service; DATABASE_URL is what the ingest scripts actually connect with —
# keep the two in sync. For local non-Docker dev, point DATABASE_URL at
# wherever Postgres is actually running instead (e.g. localhost:5432 with
# `docker compose up -d postgres` exposing that port).
POSTGRES_USER=riftbound
POSTGRES_PASSWORD=riftbound
POSTGRES_DB=riftbound
DATABASE_URL=postgresql://riftbound:riftbound@localhost:5432/riftbound
